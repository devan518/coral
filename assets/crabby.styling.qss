QWidget {
    background-color: #1f0c0a;
    color: #ffe8d0;
    font-family: Segoe UI;
    font-size: 13px;
}

QMenuBar#topbar {
    background-color: #3a1010;
    color: #ffe8d0;
    border-bottom: 2px solid #d14f2f;
    padding: 3px;
}

QMenuBar#topbar::item {
    background: transparent;
    color: #ffe8d0;
    padding: 6px 12px;
    border-radius: 5px;
}

QMenuBar#topbar::item:selected {
    background-color: #d14f2f;
    color: white;
}

QMenu {
    background-color: #3a1010;
    color: #ffe8d0;
    border: 1px solid #d9724b;
    padding: 5px;
}

QMenu::item {
    padding: 7px 26px 7px 20px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #d14f2f;
    color: white;
}

QMenu::separator {
    height: 1px;
    background-color: #b35d41;
    margin: 5px 8px;
}

QTreeView#fileTree {
    background-color: #2c0f0f;
    color: #ffe8d0;
    border: none;
    border-right: 2px solid #d14f2f;
    alternate-background-color: #3b1211;
    selection-background-color: #d9724b;
    selection-color: white;
    outline: none;
    padding: 6px;
}

QTreeView#fileTree::item {
    padding: 5px;
    border-radius: 5px;
}

QTreeView#fileTree::item:hover {
    background-color: #632b1f;
}

QTreeView#fileTree::item:selected {
    background-color: #d14f2f;
    color: white;
}

QHeaderView::section {
    background-color: #3a1010;
    color: #ffe8d0;
    border: none;
    border-bottom: 1px solid #b35d41;
    padding: 5px;
}

QPlainTextEdit#editor {
    background-color: #180906;
    color: #ffe8d0;
    border: none;
    selection-background-color: #d9724b;
    selection-color: white;
    padding: 12px;
}

QScrollBar:vertical {
    background-color: #1f0c0a;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #d14f2f;
    border-radius: 6px;
    min-height: 25px;
}

QScrollBar::handle:vertical:hover {
    background-color: #ff7f42;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #1f0c0a;
    height: 12px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #d14f2f;
    border-radius: 6px;
    min-width: 25px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #ff7f42;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

QMessageBox {
    background-color: #1f0c0a;
    color: #ffe8d0;
}

QInputDialog {
    background-color: #1f0c0a;
    color: #ffe8d0;
}

QLineEdit {
    background-color: #220b08;
    color: #ffe8d0;
    border: 1px solid #d14f2f;
    border-radius: 6px;
    padding: 7px;
    selection-background-color: #d9724b;
}

QPushButton {
    background-color: #d14f2f;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 7px 12px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #ff7f42;
}

QPushButton:pressed {
    background-color: #b34822;
}
